{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "tscanner-common": ["../../shared/tscanner-common/src/index.ts"]
    }
  },
  "include": ["src/**/*", "scripts/**/*.ts"]
}
