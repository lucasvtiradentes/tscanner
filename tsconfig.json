{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "tscanner-common": ["./shared/tscanner-common/src/index.ts"]
    }
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["registry/**/*.ts"]
}
